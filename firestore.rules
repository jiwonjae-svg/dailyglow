rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function validText(value, minLength, maxLength) {
      return value is string
        && value.size() >= minLength
        && value.size() <= maxLength;
    }

    function validOptionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function validUsername(value) {
      return value is string
        && value.matches('^[A-Za-z0-9_-]{3,20}$');
    }

    function validOptionalUsername(value) {
      return value == null || validUsername(value);
    }

    function validDocId(value, maxLength) {
      return value is string
        && value.size() >= 1
        && value.size() <= maxLength
        && value.matches('^[^/]+$');
    }

    match /quotes_catalog/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'lastLogin',
          'createdAt',
          'provider',
          'username',
          'bio',
          'settings',
          'streak',
          'badges',
          'badgeDates',
          'fcmToken',
          'followerCount',
          'followingCount'
        ])
        && !request.resource.data.keys().hasAny([
          'isAdmin',
          'isDisabled',
          'isPremium',
          'premiumPurchasedAt',
          'communitySubmissions'
        ])
        && (!request.resource.data.keys().hasAny(['username'])
          || validOptionalUsername(request.resource.data.username))
        && request.resource.data.lastLogin == request.time
        && (!request.resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt == request.time)
        && (!request.resource.data.keys().hasAny(['followerCount']) || request.resource.data.followerCount == 0)
        && (!request.resource.data.keys().hasAny(['followingCount']) || request.resource.data.followingCount == 0);

      allow update: if (
          isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'uid',
            'email',
            'displayName',
            'photoURL',
            'lastLogin',
            'provider',
            'username',
            'bio',
            'settings',
            'streak',
            'badges',
            'badgeDates',
            'fcmToken'
          ])
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'isAdmin',
            'isDisabled',
            'isPremium',
            'premiumPurchasedAt',
            'followerCount',
            'followingCount',
            'communitySubmissions'
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['username'])
            || validOptionalUsername(request.resource.data.username))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastLogin'])
            || request.resource.data.lastLogin == request.time)
        )
        || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDisabled'])
        );

      allow delete: if isOwner(userId);
    }

    match /public_profiles/{userId} {
      allow read: if true;

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'displayName',
          'username',
          'photoURL',
          'bio',
          'followerCount',
          'followingCount',
          'updatedAt'
        ])
        && validOptionalString(request.resource.data.displayName, 60)
        && validOptionalUsername(request.resource.data.username)
        && validOptionalString(request.resource.data.photoURL, 500)
        && validOptionalString(request.resource.data.bio, 200)
        && (!request.resource.data.keys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt == request.time)
        && (!request.resource.data.keys().hasAny(['followerCount']) || request.resource.data.followerCount == 0)
        && (!request.resource.data.keys().hasAny(['followingCount']) || request.resource.data.followingCount == 0);

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'username',
          'photoURL',
          'bio',
          'updatedAt'
        ])
        && validOptionalString(request.resource.data.displayName, 60)
        && validOptionalUsername(request.resource.data.username)
        && validOptionalString(request.resource.data.photoURL, 500)
        && validOptionalString(request.resource.data.bio, 200)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt == request.time);

      allow delete: if isOwner(userId);
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow delete: if signedIn()
        && validUsername(username)
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username != username;
      allow update: if false;
    }

    match /community_quotes/{quoteId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'text',
          'author',
          'submitterId',
          'submitterName',
          'submitterPhotoURL',
          'language',
          'status',
          'likeCount',
          'reportCount',
          'createdAt',
          'categories'
        ])
        && request.resource.data.submitterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && validText(request.resource.data.text, 3, 500)
        && validText(request.resource.data.author, 0, 120)
        && validText(request.resource.data.submitterName, 1, 60)
        && validOptionalString(request.resource.data.submitterPhotoURL, 500)
        && validText(request.resource.data.language, 2, 10)
        && request.resource.data.likeCount == 0
        && request.resource.data.reportCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.categories is list
        && request.resource.data.categories.size() <= 3;

      allow update: if signedIn()
        && (
          (
            resource.data.submitterId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'text',
              'author',
              'categories',
              'updatedAt'
            ])
            && validText(request.resource.data.text, 3, 500)
            && validText(request.resource.data.author, 0, 120)
            && request.resource.data.categories is list
            && request.resource.data.categories.size() <= 3
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
              || request.resource.data.updatedAt == request.time)
          )
          || (
            isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'isDisabled'
            ])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
              || request.resource.data.status in ['pending', 'approved', 'rejected'])
          )
        );

      allow delete: if signedIn()
        && resource.data.submitterId == request.auth.uid;
    }

    match /community_likes/{likeId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId', 'quoteId', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && validDocId(request.resource.data.quoteId, 200)
        && likeId == request.auth.uid + '_' + request.resource.data.quoteId
        && exists(/databases/$(database)/documents/community_quotes/$(request.resource.data.quoteId))
        && request.resource.data.createdAt == request.time;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow update: if false;
    }

    match /community_reports/{reportId} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid)
        || isAdmin();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId', 'quoteId', 'reason', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && validDocId(request.resource.data.quoteId, 200)
        && reportId == request.auth.uid + '_' + request.resource.data.quoteId
        && exists(/databases/$(database)/documents/community_quotes/$(request.resource.data.quoteId))
        && validText(request.resource.data.reason, 1, 200)
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved']);
      allow delete: if false;
    }

    match /follows/{followId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['followerId', 'followedId', 'createdAt'])
        && request.resource.data.followerId == request.auth.uid
        && validDocId(request.resource.data.followedId, 200)
        && request.resource.data.followedId != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followedId
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.resource.data.followedId));

      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;

      allow update: if false;
    }

    match /users/{userId}/notifications/{notifId} {
      allow read: if isOwner(userId);

      allow create: if signedIn()
        && notifId == 'follow_' + request.auth.uid
        && request.resource.data.keys().hasOnly([
          'type',
          'fromUid',
          'fromName',
          'fromPhotoURL',
          'read',
          'createdAt'
        ])
        && request.resource.data.type == 'follow'
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.read == false
        && validOptionalString(request.resource.data.fromName, 60)
        && validOptionalString(request.resource.data.fromPhotoURL, 500)
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;

      allow delete: if signedIn()
        && (request.auth.uid == userId
          || resource.data.fromUid == request.auth.uid);
    }

    match /users/{userId}/quoteHistory/{docId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/grassHistory/{docId} {
      allow read, write: if isOwner(userId);
    }

    match /activities/{docId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'type', 'timestamp', 'metadata'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in [
          'login',
          'logout',
          'quote_generated',
          'quote_shared',
          'quote_bookmarked',
          'speak_along_completed',
          'write_along_completed',
          'type_along_completed',
          'premium_purchased',
          'premium_cancelled'
        ]
        && request.resource.data.timestamp == request.time;
      allow read, update, delete: if false;
    }

    match /reports/{docId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid',
          'quoteId',
          'quoteText',
          'reason',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && validText(request.resource.data.quoteId, 1, 200)
        && validText(request.resource.data.quoteText, 1, 300)
        && request.resource.data.reason in ['incorrect', 'inappropriate', 'duplicate', 'other']
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /quoteRatings/{ratingId} {
      allow read: if signedIn()
        && ratingId.matches(request.auth.uid + '_.*');

      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'quoteId', 'rating', 'timestamp'])
        && request.resource.data.uid == request.auth.uid
        && validDocId(request.resource.data.quoteId, 200)
        && ratingId == request.auth.uid + '_' + request.resource.data.quoteId
        && request.resource.data.rating in ['like', 'dislike']
        && request.resource.data.timestamp == request.time;

      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }
  }
}
